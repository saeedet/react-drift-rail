{
  "name": "react-drift-rail",
  "version": "0.1.0",
  "description": "A small, accessible React rail with native scrolling and pointer dragging.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "rail",
    "draggable",
    "scroll",
    "accessible",
    "typescript"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config examples/react/vite.config.ts",
    "build": "tsup && node scripts/copy-css.mjs",
    "build:demo": "vite build --config examples/react/vite.config.ts",
    "dev:next": "next dev examples/next --webpack -p 3001",
    "build:next": "npm run build && next build examples/next --webpack",
    "start:next": "next start examples/next -p 3001",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.consumer.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-package.mjs",
    "check": "npm run build && npm run format:check && npm run lint && npm run typecheck && npm test && npm run size",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/publish-guard.mjs && npm run check",
    "test:package": "node scripts/verify-install.mjs",
    "test:next": "playwright test --config playwright.next.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "next": "^16.3.8",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
